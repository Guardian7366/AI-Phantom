[project]
name = "ai_phantom"
version = "0.1.0"
description = "AI Phantom - PPO+CNN maze explorer (no gymnasium)"
requires-python = ">=3.10"
dependencies = [
  "numpy>=1.24",
  "torch>=2.2",
  "tqdm>=4.66",
]

[tool.setuptools]
package-dir = {"" = "."}

[tool.setuptools.packages.find]
where = ["."]
include = ["ai_phantom*"]